{
    "name": "spip-contrib/facteur",
    "description": "Il distribue vos courriels",
    "type": "spip-plugin",
    "autoload": {
        "psr-4": {
            "SPIP\\Facteur\\": "inc/Facteur/"
        }
    },
    "autoload-dev": {
    },
    "require": {
        "php": "^7.4 || ^8.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.5",
        "phpstan/phpstan": "^1.4",
        "dealerdirect/phpcodesniffer-composer-installer": "^0.7.1",
        "rector/rector": "^0.12.13",
        "spip-league/easy-coding-standard": "^1.1"
    },
    "config": {
        "platform": {
            "php": "7.4.27"
        },
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    },
    "repositories": [{
        "name": "spip",
        "type": "composer",
        "url": "https://get.spip.net/composer/"
    }]
}
